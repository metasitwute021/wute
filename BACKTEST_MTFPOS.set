; ========================================================================
;  BACKTEST preset — Metasit EA v2.27-mtfpos
;  ใช้กับไฟล์: Metasit_XAUUSD_Donchian_EA_MTFPOS_TEST.mq5
;  มีเฉพาะตัวกรอง "ตำแหน่งราคาในกรอบ M30" — ไม่มีข้อ 3 / ข้อ 4 ปนเลย
;
;  ⚠️ Symbol = XAUUSD / GOLDm#   ⚠️ ห้ามใช้กับบัญชีจริง
; ========================================================================

; ============ กันชน = ปิดหมด (v2.27 ปิดด้วย 0 ได้ทุกตัว) ============
InpProfitTargetPercent=0.0
InpMaxTotalLossPercent=0.0
InpPeakDDStopPercent=0.0
InpMaxDD_Percent=0.0
InpMaxDD_ResumeBuffer=2.0
InpMaxDD_ResumeDays=2
InpDailyDD_Percent=0.0
InpMaxRiskCapPercent=0.0
InpStartBalanceOverride=0.0

; ============ ปิดเพื่อความเร็ว ============
InpEnableNotifications=false
InpStatusReport=false
InpEnableNewsFilter=false
InpUseFFNews=false
InpFFCloseBeforeNews=false
InpNoWeekendHold=false

; ============ 🧪 ตัวแปรที่ทดสอบ — ปิดไว้ = baseline ============
;  InpMtfPosMode : 0=ปิด  1=REGIME (กลางกรอบไม่เทรด)  2=DIRECTIONAL (ต้องถูกทาง)
;  InpMtfPosBars : 6 = 3 ชม. | 12 = 6 ชม. | 24 = 12 ชม. | 48 = 1 วัน
;  InpMtfPosBand : กรอบกลางกว้างกี่ % (40 -> sideway เมื่ออยู่ 30-70%)
;  InpMtfPosTF   : ไม่ได้ใส่ในไฟล์นี้ ใช้ default = M30
;
;  แผน optimization:
;    รอบ 1  InpMtfPosMode 0->2 step1  x  InpMtfPosBars 6->24 step6   (12 ชุด)
;    รอบ 2  เอาโหมด+bars ที่ดีสุด แล้วกวาด InpMtfPosBand 20->60 step10
InpMtfPosMode=0
InpMtfPosBars=6
InpMtfPosBand=40.0
InpMtfPosShift=1

; ============ Entry + Exit = ค่าที่ผ่าน forward test (ห้ามแก้) ============
InpDonchianPeriod=20
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0
InpSL_ATRMult=1.5
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpBreakEvenR=0.25
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBE_BufferPts=200.0
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false
InpFixedTP_R=2.0
InpUseStagedCloses=true
InpStagedMinProfitR=1.0
InpStrongMoveSLPercent=60.0
InpMiniMoveClosePercent=70.0
InpStagedMomentumPct=30.0
InpTrailWidest=true
InpLetWinnersRun=false
InpRunTrailWiden=1.5
InpEnableConfidence=false

; ============ Session gate = เปิด (ตรงกับของจริง เหมือนกันทุกรอบ) ============
InpBlockMarketOpen=true
InpTradeStartHourTH=8
InpThaiGMTOffset=7
InpGateMondayOnly=true
