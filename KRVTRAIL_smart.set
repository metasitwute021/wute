; ========================================================================
;  KRVTRAIL "SMART" — loss-cut แบบมี "ระยะหายใจ" (ไม่ hug ราคา)
;  ใช้กับไฟล์: Metasit_XAUUSD_Donchian_EA_KRVTRAIL.mq5
;  ปัญหาเดิม (KRVTRAIL_test): hug ราคาแน่นเกิน -> โดน whipsaw
;     -> win rate เหลือ 36% / 30 ไม้แพ้ติด / DD 12% / PF 1.13
;  แก้: InpLossCutATRMult=2.0 -> ตอนขาดทุนเว้นระยะ 2×ATR
;       ตัดเฉพาะไม้ที่ "วิ่งสวนแรงจริง" ไม่ตัด pullback ธรรมดา
;  เป้า: win rate กลับมา + avg loss ยังเล็ก + DD ต่ำลง
;  🔬 confidence ยังปิด (ทดสอบ loss-cut อย่างเดียวก่อน)
;  ⚠️ ไฟล์เทสเท่านั้น — ตัวสอบใช้ EXAM_100K_1Step_10pct.set (แยกคนละส่วน)
; ========================================================================

; ---- ENTRY (เหมือนตัวสอบ) ----
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0

; ---- STOP LOSS (ATR แบบตัวสอบ) ----
InpSLMode=0
InpSL_ATRPeriod=16
InpSL_ATRMult=1.5

; ---- RISK ----
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpMaxRiskCapPercent=1.7

; ---- BREAK-EVEN ----
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBreakEvenR=0.25
InpBE_BufferPts=200.0

; ---- PARTIAL (แบบตัวสอบ 2R) ----
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false

; ---- STAGED CLOSES (แบบตัวสอบ) ----
InpUseStagedCloses=true
InpStrongMoveATRMult=1.6
InpStrongMoveSLPercent=60.0
InpMiniMoveATRMult=1.0
InpMiniMoveClosePercent=80.0
InpStagedMomentumPct=30.0

; ---- TRAILING LAYERS (แบบตัวสอบ) ----
InpTr1_ATRPeriod=18
InpTr1_ATRMult=5.75
InpTr2_ATRPeriod=12
InpTr2_ATRMult=2.75
InpTr3_ATRPeriod=16
InpTr3_ATRMult=2.0
InpSwingLookback=20
InpCandleBackShift=3
InpTrailWidest=true
InpLetWinnersRun=false

; ---- 🔬 KRV LOSS-CUT TRAIL แบบ SMART ⭐ ----
InpTrailFromEntry=true
InpLossCutTightest=true
InpLossCutATRMult=2.0

; ---- HARD-STOP ปิดหมด (ดูว่า trail อย่างเดียวคุม DD ได้ไหม) ⭐ ----
InpMaxDD_Percent=20.0
InpMaxDD_ResumeBuffer=2.0
InpDailyDD_Percent=5.0
InpProfitTargetPercent=0.0
InpMaxTotalLossPercent=0.0
InpPeakDDStopPercent=0.0

; ---- Confidence + News ปิด ----
InpEnableConfidence=false
InpEnableNewsFilter=false
InpUseFFNews=false
