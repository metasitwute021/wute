; ========================================================================
;  KRV-MATCH v2 — แก้ SL จาก Donchian(กว้าง) -> ATR(แคบ)
;  เป้า: ลด avg loss (v1 = 987, สูงเกิน) ให้ใกล้ KRV (676)
;  เปลี่ยนแค่ SL อย่างเดียวจาก v1 (isolate ผลของ SL)
;  ⚠️ ยังเป็นไฟล์เทสเท่านั้น — ไม่ใช่ค่าสอบ! (confidence เปิด + DD guard หลวม)
; ========================================================================

; ---- ENTRY (เหมือน KRV เป๊ะ) ----
InpDonchianPeriod=20
InpMAPeriod=50
InpADXPeriod=14
InpADXMin=20.0
InpUseMomentumFilter=true
InpMomentumPct=30.0

; ---- STOP LOSS (v2: กลับเป็น ATR แคบ = ไม้แพ้เล็กลง) ⭐ จุดที่แก้ ----
InpSLMode=0
InpSL_ATRPeriod=16
InpSL_ATRMult=1.2
InpSL_DonchBufferMult=0.5

; ---- RISK ----
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpMaxRiskCapPercent=5.0

; ---- BREAK-EVEN ----
InpUseBE_ATR=true
InpBE_TriggerATR=1.5
InpBreakEvenR=0.25
InpBE_BufferPts=200.0

; ---- PARTIAL ----
InpPartialR=1.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false

; ---- STAGED CLOSES ----
InpUseStagedCloses=true
InpStagedMinProfitR=0.5
InpStrongMoveATRMult=2.75
InpStrongMoveSLPercent=60.0
InpMiniMoveATRMult=2.0
InpMiniMoveClosePercent=80.0
InpStagedMomentumPct=30.0

; ---- TRAILING ----
InpTr1_ATRPeriod=14
InpTr1_ATRMult=5.125
InpTr2_ATRPeriod=12
InpTr2_ATRMult=2.75
InpTr3_ATRPeriod=16
InpTr3_ATRMult=2.0
InpSwingLookback=20
InpCandleBackShift=3
InpTrailWidest=true
InpLetWinnersRun=false

; ---- CONFIDENCE (KRV เปิด — ⚠️ ห้ามใช้ตอนสอบ) ----
InpEnableConfidence=true
InpConfidenceTrades=10
InpConfMinWinRate=0.45
InpConfMinPF=1.2
InpConfidenceMax=2.0
InpConfidenceMin=0.5
InpConfidenceSmooth=0.25

; ---- DD GUARD หลวม (ดูกลยุทธ์ล้วนๆ — ไม่ใช่ค่าสอบ) ----
InpMaxDD_Percent=20.0
InpMaxDD_ResumeBuffer=2.0
InpDailyDD_Percent=1.5
InpProfitTargetPercent=0.0
InpMaxTotalLossPercent=0.0
InpPeakDDStopPercent=0.0

; ---- NEWS ปิด ----
InpEnableNewsFilter=false
InpUseFFNews=false
