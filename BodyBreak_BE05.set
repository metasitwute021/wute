; ========================================================================
;  Body Break EA - Break-even @ 0.5R
;  ใช้กับ: XAUUSD_H4_BodyBreak_EA.mq5 (v1.10+)
;
;  ราคาวิ่งไปทางกำไรถึง 0.5R -> เลื่อน SL มากันหน้าทุน
;  (entry + 0.05R เผื่อค่า spread/คอมมิชชั่น ให้โดนแล้วเสมอตัวจริง)
;  TP คงเดิม 1.5R, ไม่มี trailing อื่น -> เทียบกับรอบแรกได้ตรง ๆ
; ========================================================================

; ---- Break-even ----
InpUseBreakEven=true
InpBE_TriggerR=0.5
InpBE_LockR=0.05
InpUseRTrail=false
InpTrailStepR=0.1

; ---- Exit ----
InpExitMode=0
InpTP_R=1.5

; ---- Risk ----
InpRiskPercent=1.0
InpOnePosition=true
