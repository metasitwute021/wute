; ========================================================================
;  Metasit XAUUSD EA v2.27 — 25K  The5ers 3-Step Bootcamp (Step 1)
;  เป้า 6% (26,500) | Max Loss $1,250 = 5% (เส้นตาย 23,750)
;  ไม่มีกฎ Daily Loss | Leverage 1:30 | Time Limit ไม่จำกัด | Profit Split 100%
;
;  สถานะบัญชี: เล่นต่อ  balance 25,635.22 (+2.54% กำไรอยู่)
;  ต้องทำอีก +3.37%  |  buffer ถึงเส้นตาย $1,885 (แพ้ติดได้ 7.5 ไม้ @risk 1%)
;
;  โหมด: RUN — ปิดตัวพักภายในทั้งหมด ให้ EA เทรดต่อเนื่อง
; ========================================================================

; ---- ⚠️ ยอดเริ่มสอบจริง (ถ้าไม่ตั้ง เกราะกับเป้าจะเลื่อนผิด) ----
InpStartBalanceOverride=25000.0

; ---- Entry (ค่าที่พิสูจน์แล้ว ห้ามแก้) ----
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0
InpSL_ATRMult=1.5

; ---- Risk ----
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpMaxRiskCapPercent=1.7

; ---- Break-even + Staged closes (BANK-EARLY, forward test ผ่าน) ----
InpBreakEvenR=0.25
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBE_BufferPts=200.0
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false
InpFixedTP_R=2.0
InpUseStagedCloses=true
InpStagedMinProfitR=1.0
InpStrongMoveSLPercent=60.0
InpMiniMoveClosePercent=70.0
InpStagedMomentumPct=30.0
InpTrailWidest=true
InpLetWinnersRun=false
InpRunTrailWiden=1.5

; ---- Session gate: บล็อกเฉพาะเช้าวันจันทร์ (สัญญาณค้างจากศุกร์) ----
InpBlockMarketOpen=true
InpTradeStartHourTH=8
InpThaiGMTOffset=7
InpGateMondayOnly=true

; ---- ถือข้ามสัปดาห์ได้ ----
InpNoWeekendHold=false
InpWeekendCloseHour=20

; ---- News filter ----
InpEnableNewsFilter=true
InpNewsMinutesBefore=90
InpNewsMinutesAfter=30
InpNewsCurrencies=USD
InpUseFFNews=false
InpFFNewsFile=ff_news.csv
InpFFBlockImpact=High
InpFFTimeOffsetHours=0
InpFFCloseBeforeNews=false

; ---- Confidence OFF ----
InpEnableConfidence=false

; ---- แจ้งเตือนครบทุกสาเหตุ (v2.27) ----
InpEnableNotifications=true
InpStatusReport=true

; ---- เกราะ: เหลือชั้นเดียว ตามที่สั่งให้รันต่อ ----
; MaxDD pause  = ปิด (ตัวนี้แหละที่แช่แข็ง EA 4 บัญชี)
; Daily DD     = ปิด (Bootcamp ไม่มีกฎ daily loss)
; เบรกฉุกเฉิน  = 4.5% จาก 25,000 -> ปิดหมดที่ 23,875 (เหนือเส้นตาย $125)
;                เก็บไว้เพื่อไม่ให้โบรกเป็นคนปิดเอง ถ้าไม่อยากได้เลย ใส่ 0
InpMaxDD_Percent=0.0
InpMaxDD_ResumeBuffer=2.0
InpMaxDD_ResumeDays=2
InpDailyDD_Percent=0.0
InpProfitTargetPercent=6.0
InpMaxTotalLossPercent=4.5
InpPeakDDStopPercent=0.0
