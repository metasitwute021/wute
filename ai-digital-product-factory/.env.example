# AI Digital Product Factory - environment variables
# Copy to your n8n instance environment. NEVER commit real values.
#
# n8n must be started with env access enabled for expressions:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---- OpenAI (the API key itself lives in the n8n "OpenAI" credential) ------
OPENAI_MODEL_TEXT=gpt-4.1
OPENAI_MODEL_IMAGE=gpt-image-1
OPENAI_IMAGE_QUALITY=high

# ---- Etsy (token lives in the n8n OAuth2 credential) ----------------------
ETSY_API_BASE=https://openapi.etsy.com
ETSY_API_KEY=your-etsy-app-keystring
ETSY_SHOP_ID=12345678
# draft = a human reviews before it goes live (recommended). active = instant publish.
ETSY_LISTING_STATE=draft
# Numeric Etsy taxonomy id for your category - verify it before the first real run.
ETSY_TAXONOMY_ID=2078

# ---- Google Drive (token lives in the n8n OAuth2 credential) --------------
# Folder id that will contain "AI Digital Product Factory". Use root for My Drive.
GDRIVE_ROOT_FOLDER_ID=root

# ---- Database -------------------------------------------------------------
# postgres (recommended) or sqlite (self-hosted n8n with the sqlite3 CLI only)
DB_TYPE=postgres
DB_SQLITE_PATH=/home/node/.n8n/adpf.db

# ---- Factory behaviour ----------------------------------------------------
PROMPT_VERSION=v1.0.0
# Rotation used when the run does not name a factory (factory=auto).
FACTORY_ROTATION=planner,printable,canva,wallart,resume,spreadsheet,kids,svg

# ---- Alerting (optional) --------------------------------------------------
ALERT_WEBHOOK_URL=

# ==========================================================================
# V2 modules (07-10). These require PostgreSQL.
# ==========================================================================

# ---- Idea Factory (07) ----------------------------------------------------
IDEA_TARGET_COUNT=200
IDEA_BATCH_SIZE=25
DUPLICATE_SIMILARITY_THRESHOLD=0.62
# true turns a same-title product into version N+1 instead of rejecting it
ALLOW_PRODUCT_REVISION=false

# ---- Cost and budget (08) -------------------------------------------------
BUDGET_DAILY_USD=20
BUDGET_MONTHLY_USD=300
BUDGET_RUN_RESERVE_USD=3
OPENAI_IMAGE_UNIT_COST_USD=0.19
OPENAI_CHAT_RUN_COST_USD=0.12
# Per-model price override, e.g. {"gpt-4.1":[2.0,8.0],"gpt-image-1":0.19}
OPENAI_PRICE_OVERRIDE_JSON={}

# ---- Feedback learning (09) ----------------------------------------------
LEARNING_WINDOW_DAYS=30
# Below this many measured products the learning agent is forced to "no_change"
LEARNING_MIN_SAMPLE=15
AB_MIN_VIEWS_PER_ARM=200
AB_MIN_RELATIVE_LIFT=0.20
