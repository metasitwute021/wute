; ========================================================================
;  BACKTEST preset — Metasit EA v2.20 (ตัวเดิม ก่อนแก้)
;  ใช้กับไฟล์: Metasit_XAUUSD_Donchian_EA_v2.20_ORIGINAL.mq5
;
;  ตั้งค่าให้ "เทียบกับผลของ v2.27 บนทองได้ตรงๆ" ทุกค่าที่เหมือนกันได้
;  ⚠️ ห้ามใช้กับบัญชีจริง — ไม่มีเกราะเหลือเลย
; ========================================================================

; ========================================================================
;  🔴🔴 สำคัญมาก — v2.20 ปิด 2 ตัวนี้ด้วย 0 ไม่ได้!
;  โค้ด v2.20 เช็คแค่ (ddPct >= InpMaxDD_Percent) ไม่มีตัวกัน
;  ตั้ง 0 -> 0 >= 0 เป็นจริงตั้งแต่ติ๊กแรก -> EA พักทันที ไม่มีไม้เลย
;  จึงต้องตั้งค่าสูงๆ แทนการตั้ง 0  (บั๊กนี้ v2.27 แก้แล้ว)
; ========================================================================
InpMaxDD_Percent=100.0
InpDailyDD_Percent=100.0

; ---- ตัวที่ปิดด้วย 0 ได้ปกติ (v2.20 มี guard <= 0 อยู่แล้ว) ----
InpProfitTargetPercent=0.0
InpMaxTotalLossPercent=0.0
InpPeakDDStopPercent=0.0
InpMaxRiskCapPercent=0.0
InpMaxDD_ResumeBuffer=2.0

; ---- ปิดเพื่อความเร็ว ----
InpEnableNotifications=false
InpStatusReport=false
InpEnableNewsFilter=false
InpUseFFNews=false
InpFFCloseBeforeNews=false

; ========================================================================
;  🧪 ตัวแปรเดียวที่ควรสลับ — ถือข้ามสัปดาห์
;
;  false = ถือข้ามสุดสัปดาห์  -> ตรงกับ run ของ v2.27 บนทอง (เทียบกันได้)
;  true  = ปิดไม้ทิ้งทุกศุกร์ -> พฤติกรรมดั้งเดิมของ v2.20 จริงๆ
;
;  รัน 2 รอบด้วยไฟล์เดียวกัน สลับแค่ค่านี้ จะได้คำตอบว่า
;  "การเปิดให้ถือข้ามสัปดาห์ ช่วยหรือทำร้าย" โดยไม่มีตัวแปรอื่นปน
; ========================================================================
InpNoWeekendHold=false
InpWeekendCloseHour=20

; ---- Entry + Exit = ค่าเดียวกับที่ใช้เทส v2.27 ทุกตัว ----
InpDonchianPeriod=20
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0
InpSL_ATRMult=1.5
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpBreakEvenR=0.25
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBE_BufferPts=200.0
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false
InpFixedTP_R=2.0
InpUseStagedCloses=true
InpStagedMinProfitR=1.0
InpStrongMoveSLPercent=60.0
InpMiniMoveClosePercent=70.0
InpStagedMomentumPct=30.0
InpTrailWidest=true
InpLetWinnersRun=false
InpRunTrailWiden=1.5
InpEnableConfidence=false
