; ========================================================================
;  BACKTEST preset — Metasit EA v2.27-combo
;  ใช้กับไฟล์: Metasit_XAUUSD_Donchian_EA_COMBO_TEST.mq5
;  มีทั้งข้อ 3 (range filter) และข้อ 4 (after-loss) ในไฟล์เดียว ปิดไว้ทั้งคู่
;
;  ⚠️ Symbol ต้องเป็น XAUUSD / GOLDm#  (ไม่ใช่ EUR!)
;  ⚠️ ห้ามใช้กับบัญชีจริง — ไม่มีเกราะเหลือเลย
; ========================================================================

; ============ กันชน = ปิดหมด (v2.27 ปิดด้วย 0 ได้ทุกตัว) ============
InpProfitTargetPercent=0.0
InpMaxTotalLossPercent=0.0
InpPeakDDStopPercent=0.0
InpMaxDD_Percent=0.0
InpMaxDD_ResumeBuffer=2.0
InpMaxDD_ResumeDays=2
InpDailyDD_Percent=0.0
InpMaxRiskCapPercent=0.0
InpStartBalanceOverride=0.0

; ============ ปิดเพื่อความเร็ว ============
InpEnableNotifications=false
InpStatusReport=false
InpEnableNewsFilter=false
InpUseFFNews=false
InpFFCloseBeforeNews=false
InpNoWeekendHold=false

; ============ 🧪 A: RANGE FILTER (ข้อ 3) — ปิดไว้ = baseline ============
;  A1 กรอบต้องกว้าง >= k x ATR      -> กรอง range ที่บีบตัว
;  A2 กรอบต้องกว้างกว่า N แท่งก่อน  -> กรอง range ที่นิ่ง
InpMinChannelATR=0.0
InpChannelExpandBars=0
InpChannelExpandRatio=1.0

; ============ 🧪 B: AFTER-LOSS BLOCK (ข้อ 4) — ปิดไว้ = baseline ============
;  0=ปิด  1=ห้ามพลิกทาง  2=ห้ามทางเดิมซ้ำ (ตรงกับเคสจริง)  3=ห้ามทั้งคู่
InpAfterLossBlock=0
InpAfterLossBars=2

; ============ 🧪 C: LOWER-TF RANGE POSITION (M30) — ปิดไว้ = baseline ============
;  0=ปิด  1=กลางกรอบไม่เทรด(regime)  2=ต้องถูกทาง(directional)
;  InpMtfPosTF   : 16385=M30 ตามค่า default (ไม่ต้องใส่ก็ได้)
;  InpMtfPosBars : 6 = 3 ชม. | 12 = 6 ชม. | 48 = 1 วัน
InpMtfPosMode=0
InpMtfPosBars=6
InpMtfPosBand=40.0
InpMtfPosShift=1

; ============ Entry + Exit = ค่าที่ผ่าน forward test (ห้ามแก้) ============
InpDonchianPeriod=20
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0
InpSL_ATRMult=1.5
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpBreakEvenR=0.25
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBE_BufferPts=200.0
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false
InpFixedTP_R=2.0
InpUseStagedCloses=true
InpStagedMinProfitR=1.0
InpStrongMoveSLPercent=60.0
InpMiniMoveClosePercent=70.0
InpStagedMomentumPct=30.0
InpTrailWidest=true
InpLetWinnersRun=false
InpRunTrailWiden=1.5
InpEnableConfidence=false

; ============ Session gate = เปิด (ตรงกับของจริง เหมือนกันทุกรอบ) ============
InpBlockMarketOpen=true
InpTradeStartHourTH=8
InpThaiGMTOffset=7
InpGateMondayOnly=true
