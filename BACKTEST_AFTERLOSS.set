; ========================================================================
;  BACKTEST preset — Metasit EA v2.27-afterloss
;  ใช้กับไฟล์: Metasit_XAUUSD_Donchian_EA_AFTERLOSS_TEST.mq5
;
;  ปิด "กันชน" ทุกตัว เพื่อให้ EA เทรดยาวตลอดช่วงทดสอบ ไม่หยุดกลางคัน
;  ⚠️ ห้ามใช้กับบัญชีจริง — ไม่มีเกราะเหลือเลยสักชั้น
; ========================================================================

; ============ 🔴 กันชน = ปิดหมด (0 = off ทุกตัวใน v2.27) ============
InpProfitTargetPercent=0.0     ; ถึงเป้าแล้วหยุด -> ปิด (สำคัญสุด ไม่งั้นเทสจบเร็ว)
InpMaxTotalLossPercent=0.0     ; เบรกฉุกเฉิน
InpPeakDDStopPercent=0.0       ; DD Lock
InpMaxDD_Percent=0.0           ; พัก EA ตอน DD สูง
InpMaxDD_ResumeBuffer=2.0
InpMaxDD_ResumeDays=2
InpDailyDD_Percent=0.0         ; หยุดรายวัน
InpMaxRiskCapPercent=0.0       ; ข้ามไม้เสี่ยงเกิน -> ปิด (ไม่งั้นกลุ่มตัวอย่างไม่ครบ)
InpStartBalanceOverride=0.0

; ============ 🔴 ปิดเพื่อความเร็ว ============
InpEnableNotifications=false
InpStatusReport=false
InpEnableNewsFilter=false
InpUseFFNews=false
InpFFCloseBeforeNews=false
InpNoWeekendHold=false

; ============ 🧪 ตัวแปรที่ทดสอบ ============
;  InpAfterLossBlock: 0=ปิด(baseline)  1=ห้ามพลิกทาง  2=ห้ามทางเดิมซ้ำ  3=ห้ามทั้งคู่
;  เคสจริง ก.ย.2026 = SELL แพ้ติด 3 ไม้ -> โหมด 2 คือตัวที่ตรงกับปัญหา
;  แนะนำ: Optimization  InpAfterLossBlock 0..3 step1  x  InpAfterLossBars 1..6 step1
InpAfterLossBlock=0
InpAfterLossBars=2

; ============ ⚪ Entry + Exit = ค่าที่ผ่าน forward test (ห้ามแก้) ============
InpUseMomentumFilter=true
InpMomentumPct=30.0
InpADXMin=20.0
InpSL_ATRMult=1.5
InpRiskPercent=1.0
InpMaxPositions=1
InpReentryCooldownBars=1
InpBreakEvenR=0.25
InpUseBE_ATR=true
InpBE_TriggerATR=1.0
InpBE_BufferPts=200.0
InpPartialR=2.0
InpPartialPercent=40.0
InpLockTrailUntilPartial=true
InpUseFixedTP=false
InpFixedTP_R=2.0
InpUseStagedCloses=true
InpStagedMinProfitR=1.0
InpStrongMoveSLPercent=60.0
InpMiniMoveClosePercent=70.0
InpStagedMomentumPct=30.0
InpTrailWidest=true
InpLetWinnersRun=false
InpRunTrailWiden=1.5
InpEnableConfidence=false

; ============ ⚪ Session gate = เปิด (ตรงกับของจริง เหมือนกันทุกรอบ) ============
InpBlockMarketOpen=true
InpTradeStartHourTH=8
InpThaiGMTOffset=7
InpGateMondayOnly=true
